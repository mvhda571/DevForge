# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173
# Set to true behind HTTPS in production
COOKIE_SECURE=false
# Timezone offset used for streaks and "today" (minutes from UTC). Tashkent = 300
APP_TZ_OFFSET_MINUTES=300

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/devforge
# Used only by the test suite (the database is dropped after tests)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/devforge_test

# --- Auth ---
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- AI provider ---
# demo | anthropic | openai   (demo works without any key and is clearly labeled in the UI)
AI_PROVIDER=demo
AI_API_KEY=
# Optional: override the default model for the chosen provider
AI_MODEL=
# Optional: OpenAI-compatible or proxy base URL
AI_BASE_URL=
AI_MAX_TOKENS=900
AI_TIMEOUT_MS=30000

# --- OpenStreetMap / Overpass (nearby places on the map) ---
OVERPASS_ENABLED=true
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Seeding ---
# Create demo accounts with: npm run seed -- --demo   (or SEED_DEMO_USERS=true)
SEED_DEMO_USERS=false
DEMO_PASSWORD=change-me-demo-password
# Optional: create/ensure a real admin account during seeding
ADMIN_EMAIL=
ADMIN_PASSWORD=
